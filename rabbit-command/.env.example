# ═══════════════════════════════════════
#  Rabbit Command — Environment Variables
# ═══════════════════════════════════════

# Discord
DISCORD_BOT_TOKEN=          # Bot token from Discord Developer Portal
DISCORD_GUILD_ID=           # Right-click server name → Copy Server ID

# Channel IDs (right-click channel → Copy Channel ID)
CHANNEL_READER=             # #rabbit-reader
CHANNEL_RSS=                # #rss-feeds
CHANNEL_LOGS=               # #bot-logs

# Notion
NOTION_API_KEY=             # From notion.so/my-integrations
NOTION_BOOKS_DB=            # Books database ID
NOTION_FEEDS_DB=            # Feeds database ID

# Server
PORT=3000
